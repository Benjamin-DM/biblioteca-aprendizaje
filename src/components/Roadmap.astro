---
import type { CollectionEntry } from 'astro:content';
import { claveTarea } from '../lib/roadmap';

type Props = { roadmap: CollectionEntry<'roadmaps'>; curso: string };
const { roadmap, curso } = Astro.props;
const { fases } = roadmap.data;
---

<ol class="mt-4 space-y-6" data-roadmap>
  {
    fases.map((fase, i) => (
      <li class="rounded-lg border border-borde bg-superficie p-4">
        <h3 class="text-lg font-semibold">
          Fase {i + 1}: {fase.titulo}
        </h3>
        <ol class="mt-3 grid gap-4 md:grid-cols-2">
          {fase.semanas.map((semana) => (
            <li>
              <h4 class="font-medium">
                Semana {semana.numero}: {semana.titulo}
              </h4>
              <ul class="mt-1 space-y-1 text-sm">
                {semana.tareas.map((tarea) => (
                  <li>
                    <label class="flex gap-2">
                      <input type="checkbox" disabled class="mt-1 size-4 shrink-0" data-clave={claveTarea(curso, semana.numero, tarea)} />
                      <span>{tarea}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
        <p class="mt-4 border-l-4 border-acento pl-3 text-sm">
          <strong>Gate para avanzar:</strong> {fase.gate}
        </p>
      </li>
    ))
  }
</ol>
<script>
  import { enlazarCasillas } from '../lib/casillas';
  const casillas = [...document.querySelectorAll<HTMLInputElement>('[data-roadmap] input[data-clave]')];
  enlazarCasillas(casillas, 'roadmap', (c) => c.dataset.clave!);
</script>
