---
import { render } from 'astro:content';
import BotonCopiar from '../../../../components/BotonCopiar.astro';
import LogErrores from '../../../../components/LogErrores';
import ProgresoLeccion from '../../../../components/ProgresoLeccion';
import Base from '../../../../layouts/Base.astro';
import type { Curso, Lab, Modulo } from '../../../../lib/arbol';
import { obtenerArbol, u } from '../../../../lib/contenido';

export async function getStaticPaths() {
  const cursos = await obtenerArbol();
  return cursos.flatMap((curso) =>
    curso.modulos.flatMap((modulo) =>
      modulo.labs.map((lab) => ({
        params: { curso: curso.slug, lab: lab.slug },
        props: { curso, modulo, lab },
      })),
    ),
  );
}

const { curso, modulo, lab } = Astro.props as { curso: Curso; modulo: Modulo; lab: Lab };
const d = lab.entrada.data;
const { Content } = await render(lab.entrada);
const dominio = modulo.entrada.data.dominio?.nombre;
---

<Base titulo={d.titulo} descripcion={d.objetivo}>
  <nav aria-label="Migas de pan" class="text-sm">
    <a class="enlace" href={u(curso.ruta)}>{curso.entrada.data.titulo}</a>
    <span aria-hidden="true"> / </span>
    <span>{modulo.entrada.data.titulo}</span>
  </nav>
  <div data-pagefind-body>
  <h1 class="mt-2 text-3xl font-bold">{d.titulo}</h1>
  <p class="mt-2 text-sm text-tenue">
    Lab · {d.duracion_min} min{dominio && ` · Dominio: ${dominio}`}
  </p>
  <section class="mt-6 rounded-lg border border-borde bg-superficie p-4" aria-labelledby="objetivo">
    <h2 id="objetivo" class="font-semibold">Objetivo</h2>
    <p class="mt-1">{d.objetivo}</p>
  </section>
  <section class="mt-6" aria-labelledby="pasos">
    <h2 id="pasos" class="text-2xl font-bold">Pasos</h2>
    <div class="prose mt-4"><Content /></div>
    <BotonCopiar />
  </section>
  <section class="mt-8 rounded-lg border border-acento p-4" aria-labelledby="hecho">
    <h2 id="hecho" class="font-semibold">Criterio de "hecho"</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      {d.criterio_hecho.map((c) => <li>{c}</li>)}
    </ul>
  </section>
  </div>
  <ProgresoLeccion client:load id={lab.entrada.id} curso={curso.slug} />
  <LogErrores client:only="react" lab={lab.entrada.id} curso={curso.slug} />
</Base>
