---
import { render } from 'astro:content';
import PesosDominio from '../../../components/PesosDominio.astro';
import ProgresoCurso from '../../../components/ProgresoCurso';
import { resumir } from '../../../lib/resumen';
import Roadmap from '../../../components/Roadmap.astro';
import Base from '../../../layouts/Base.astro';
import { contarPreguntas, type Curso } from '../../../lib/arbol';
import { ETIQUETAS, obtenerArbol, u } from '../../../lib/contenido';

export async function getStaticPaths() {
  const cursos = await obtenerArbol();
  return cursos.map((curso) => ({ params: { curso: curso.slug }, props: { curso } }));
}

const { curso } = Astro.props as { curso: Curso };
const d = curso.entrada.data;
const { Content: Descripcion } = await render(curso.entrada);
const Recursos = curso.recursos && (await render(curso.recursos)).Content;
const dominios = curso.modulos.flatMap((m) => m.entrada.data.dominio ?? []);
const preguntas = contarPreguntas(curso);
const fechaMeta = d.fecha_meta?.toLocaleDateString('es', { dateStyle: 'long', timeZone: 'UTC' });
---

<Base titulo={d.titulo} descripcion={d.objetivo}>
  <nav aria-label="Migas de pan" class="text-sm">
    <a class="enlace" href={u('biblioteca/')}>Biblioteca</a>
    <span aria-hidden="true"> / </span>
    <span>{curso.area.data.nombre}</span>
  </nav>
  <div data-pagefind-body>
  <h1 class="mt-2 text-3xl font-bold">{d.titulo}</h1>
  <p class="mt-2 text-lg">{d.objetivo}</p>
  <p class="mt-2 text-sm text-tenue">
    {ETIQUETAS.nivel[d.nivel]} · {ETIQUETAS.estado[d.estado]} · {d.horas_semana} h por semana
    {fechaMeta && ` · Fecha meta: ${fechaMeta}`}
  </p>
  {
    d.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2 text-sm" aria-label="Tags">
        {d.tags.map((t) => (
          <li class="rounded border border-borde px-2 py-0.5">{t}</li>
        ))}
      </ul>
    )
  }
  <ProgresoCurso client:load curso={resumir(curso)} />
  <div class="prose mt-4"><Descripcion /></div>

  {
    dominios.length > 0 && (
      <section class="mt-10" aria-labelledby="dominios">
        <h2 id="dominios" class="text-2xl font-bold">
          Peso de cada dominio en el examen
        </h2>
        <PesosDominio dominios={dominios} />
      </section>
    )
  }

  {
    curso.roadmap && (
      <section class="mt-10" aria-labelledby="roadmap">
        <h2 id="roadmap" class="text-2xl font-bold">
          Roadmap
        </h2>
        <Roadmap roadmap={curso.roadmap} curso={curso.slug} />
      </section>
    )
  }

  <section class="mt-10" aria-labelledby="modulos">
    <h2 id="modulos" class="text-2xl font-bold">Módulos</h2>
    {
      curso.modulos.length === 0 ? (
        <p class="mt-3">Este curso todavía no tiene módulos. Agrégalos en su carpeta de contenido.</p>
      ) : (
        <>
          {preguntas > 0 && (
            <p class="mt-2 text-sm" data-pagefind-ignore>
              <a class="enlace" href={u(`quiz/?curso=${curso.slug}`)}>
                Hacer un quiz del curso
              </a>{' '}
              <span class="text-tenue">({preguntas} preguntas en total)</span>
            </p>
          )}
          <ol class="mt-4 space-y-4">
            {curso.modulos.map((m) => (
              <li class="rounded-lg border border-borde bg-superficie p-4">
                <h3 class="text-lg font-semibold">{m.entrada.data.titulo}</h3>
                {m.lecciones.length > 0 && (
                  <>
                    <h4 class="mt-3 text-sm font-semibold text-tenue">Lecciones</h4>
                    <ol class="mt-1 space-y-1">
                      {m.lecciones.map((l) => (
                        <li>
                          <a class="enlace" href={u(l.ruta)}>
                            {l.entrada.data.titulo}
                          </a>
                          <span class="text-sm text-tenue"> · {l.entrada.data.duracion_min} min</span>
                          <span class="text-sm font-semibold" data-estado-item={l.entrada.id} />
                        </li>
                      ))}
                    </ol>
                  </>
                )}
                {m.labs.length > 0 && (
                  <>
                    <h4 class="mt-3 text-sm font-semibold text-tenue">Labs</h4>
                    <ol class="mt-1 space-y-1">
                      {m.labs.map((l) => (
                        <li>
                          <a class="enlace" href={u(l.ruta)}>
                            {l.entrada.data.titulo}
                          </a>
                          <span class="text-sm text-tenue"> · {l.entrada.data.duracion_min} min</span>
                          <span class="text-sm font-semibold" data-estado-item={l.entrada.id} />
                        </li>
                      ))}
                    </ol>
                  </>
                )}
              </li>
            ))}
          </ol>
        </>
      )
    }
  </section>

  {
    Recursos && (
      <section class="mt-10" aria-labelledby="recursos">
        <h2 id="recursos" class="text-2xl font-bold">
          Recursos
        </h2>
        <div class="prose mt-4 max-w-none">
          <Recursos />
        </div>
      </section>
    )
  }

  {
    d.fuentes.length > 0 && (
      <section class="mt-10" aria-labelledby="fuentes">
        <h2 id="fuentes" class="text-2xl font-bold">
          Fuentes oficiales
        </h2>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          {d.fuentes.map((f) => (
            <li>
              <a class="enlace" href={f.url} rel="noopener">
                {f.titulo}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  </div>
</Base>
