---
import Dashboard from '../components/Dashboard';
import Base from '../layouts/Base.astro';
import { obtenerArbol } from '../lib/contenido';
import { resumir } from '../lib/resumen';

const cursos = (await obtenerArbol()).map(resumir);
---

<Base titulo="Inicio">
  <h1 class="mb-6 text-3xl font-bold">Inicio</h1>
  <Dashboard client:load cursos={cursos} />
</Base>
